{
  "permissions": {
    "deny": [
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(tofu state rm*)",
      "Bash(az * delete*)",
      "Bash(just bootstrap-apply*)",
      "Bash(just bootstrap-migrate*)",
      "Bash(just secrets-sync*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { jq -e .stop_hook_active >/dev/null && exit 0; just e2e >&2 || exit 2; }",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
